TRACKRELAY_APP_NAME=TrackRelay
TRACKRELAY_ENVIRONMENT=local
TRACKRELAY_DEBUG=false

# Local PostgreSQL development settings. Do not reuse these credentials elsewhere.
POSTGRES_DB=trackrelay
POSTGRES_USER=trackrelay
POSTGRES_PASSWORD=trackrelay
POSTGRES_PORT=5433
TRACKRELAY_DATABASE_URL=postgresql+psycopg://trackrelay:trackrelay@localhost:5433/trackrelay

# Local downstream order-system simulator.
TRACKRELAY_DOWNSTREAM_URL=http://127.0.0.1:8001
TRACKRELAY_DOWNSTREAM_TIMEOUT_SECONDS=5.0
