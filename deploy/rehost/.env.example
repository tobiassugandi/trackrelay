# The same image runs migrations, the API, and the downstream simulator.
# Cloud deployment will replace this local tag with a session-owned ECR URI.
TRACKRELAY_API_IMAGE=trackrelay-api:local
TRACKRELAY_IMAGE_PULL_POLICY=missing
TRACKRELAY_POSTGRES_IMAGE=postgres:17-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
TRACKRELAY_POSTGRES_PULL_POLICY=missing

# Bind locally by default. Cloud session configuration must explicitly use
# 0.0.0.0; the EC2 security group remains the external /32 boundary.
TRACKRELAY_API_BIND_ADDRESS=127.0.0.1
TRACKRELAY_API_PORT=8000

# Synthetic rehost database settings. Generate a random URL-safe password in a
# private runtime env file; never reuse or commit the example value.
POSTGRES_DB=trackrelay
POSTGRES_USER=trackrelay
POSTGRES_PASSWORD=replace-with-random-url-safe-value

TRACKRELAY_DOWNSTREAM_TIMEOUT_SECONDS=5.0
